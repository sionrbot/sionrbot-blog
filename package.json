{
  "name": "sionrbot-blog",
  "type": "module",
  "version": "1.5.1",
  "engines": {
    "node": "^24.22.2 || >=26.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "ignore"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "vp lint . && eslint .",
    "i18n:check": "x18n check --strict",
    "format": "vp fmt .",
    "astro": "astro",
    "test:unit": "vp test --project unit",
    "test:unit:tz": "node tests/support/run-date-timezones.ts",
    "test:build": "vp test --project build",
    "test:e2e": "node tests/support/run-e2e.ts deterministic",
    "test:e2e:ai": "node tests/support/run-e2e.ts ai"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/lucide": "^1.2.151",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "7.4.5",
    "astro-icon": "^1.2.0",
    "katex": "^0.19.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4"
  },
  "allowScripts": {
    "esbuild": true
  },
  "packageManager": "pnpm@11.28.10",
  "devDependencies": {
    "@ai-sdk/openai": "4.0.102",
    "@astrojs/check": "^0.9.12",
    "@e2e-dev/web": "0.15.4",
    "@typescript-eslint/parser": "^8.72.1",
    "@x18n/cli": "0.1.8",
    "ai": "^7.0.162",
    "cf": "1.0.0-beta.28",
    "cheerio": "1.2.0",
    "e2e": "0.22.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "fast-xml-parser": "5.12.0",
    "release-please": "17.11.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "4.158.0",
    "zod": "^4.6.7"
  },
  "private": true,
  "license": "MIT",
  "description": "A minimal, typography-first Astro theme."
}
